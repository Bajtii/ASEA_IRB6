<Window x:Class="RobotGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Robot GUI"
        Height="450"
        Width="800"
        WindowState="Maximized"
        Icon="pack://application:,,,/Assets/logo.png">

    <Grid Margin="10">

        <!-- === Columns / Rows ============================================================ -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 0. Upload + status -->
            <RowDefinition Height="Auto" />
            <!-- 1. LOGO (original comment preserved) -->
            <RowDefinition Height="*" />
            <!-- 2. (blank spacer) -->
            <RowDefinition Height="Auto" />
            <!-- 3. Port / Baud / Rotation -->
            <RowDefinition Height="Auto" />
            <!-- 4. Buttons -->
        </Grid.RowDefinitions>

        <!-- ===== 0. File upload + status ================================================= -->
        <StackPanel Grid.Row="0"
                    Grid.Column="0"
                    Orientation="Vertical"
                    Margin="0,0,10,0">

            <Button x:Name="BtnLoad"
                    Width="150"
                    Height="30"
                    Content="Load Files"
                    Click="BtnLoad_Click" />

            <ScrollViewer Height="100"
                          Margin="0,8,0,0"
                          VerticalScrollBarVisibility="Auto"
                          Background="#FFF0F0F0">

                <TextBlock x:Name="TxtStatus"
                           TextWrapping="Wrap"
                           Foreground="Green"
                           FontWeight="Bold"
                           Visibility="Collapsed" />
            </ScrollViewer>
        </StackPanel>

        <!-- ===== LOGO (row 2) =========================================================== -->
        <Image Grid.Row="2"
               Source="pack://application:,,,/Assets/logo.png"
               Width="300"
               Height="151"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderTransformOrigin="0.178,0.513" />

        <!-- ===== 2. Port / Baud / Rotation / Density / Z / Threshold =================== -->
        <StackPanel Grid.Row="3"
                    Grid.Column="0"
                    Orientation="Vertical"
                    HorizontalAlignment="Center"
                    Margin="0,0,10,0">

            <!-- Port + Baud + Rotation -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,5">

                <TextBlock Text="Port:"
                           Margin="0,0,5,0"
                           VerticalAlignment="Center" />

                <ComboBox x:Name="CmbPort"
                          Width="80">

                    <ComboBoxItem>COM1</ComboBoxItem>
                    <ComboBoxItem>COM2</ComboBoxItem>
                    <ComboBoxItem>COM3</ComboBoxItem>
                    <ComboBoxItem>COM4</ComboBoxItem>
                    <ComboBoxItem>COM5</ComboBoxItem>
                    <ComboBoxItem IsSelected="True">COM6</ComboBoxItem>
                    <ComboBoxItem>COM7</ComboBoxItem>
                    <ComboBoxItem>COM8</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="Baud:"
                           Margin="15,0,5,0"
                           VerticalAlignment="Center" />

                <ComboBox x:Name="CmbBaud"
                          Width="100">

                    <ComboBoxItem>9600</ComboBoxItem>
                    <ComboBoxItem>38400</ComboBoxItem>
                    <ComboBoxItem>57600</ComboBoxItem>
                    <ComboBoxItem IsSelected="True">115200</ComboBoxItem>
                    <ComboBoxItem>250000</ComboBoxItem>
                </ComboBox>

                <CheckBox x:Name="ChkRotate"
                          Content="Rotate 90°"
                          IsChecked="True"
                          Margin="15,0,0,0"
                          VerticalAlignment="Center"
                          Checked="ChkRotate_CheckedChanged"
                          Unchecked="ChkRotate_CheckedChanged" />
            </StackPanel>

            <!-- Density info -->
            <TextBlock x:Name="TxtDensityUsed"
                       Text="Density: 70 %"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />

            <!-- Z value field + regenerate button -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,5,0,0">

                <TextBlock Text="Z (drawing height):"
                           Margin="0,0,5,0"
                           VerticalAlignment="Center" />

                <TextBox x:Name="TxtZ"
                         Width="80"
                         Text="0.9825"
                         VerticalContentAlignment="Center"
                         LostFocus="TxtZ_LostFocus" />

                <Button x:Name="BtnRegenZ"
                        Content="Regenerate"
                        Width="90"
                        Margin="5,0,0,0"
                        Click="BtnRegenZ_Click" />
            </StackPanel>

            <!-- Double edge threshold slider -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,5,0,0">

                <TextBlock Text="Double edge threshold:"
                           Margin="0,0,5,0"
                           VerticalAlignment="Center" />

                <Slider x:Name="SldEdgeThreshold"
                        Width="150"
                        Minimum="0.01"
                        Maximum="0.99"
                        Value="0.85"
                        TickFrequency="0.01"
                        IsSnapToTickEnabled="True"
                        ValueChanged="SldEdgeThreshold_ValueChanged" />

                <TextBlock x:Name="TxtEdgeValue"
                           Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           Text="0.85" />
            </StackPanel>
        </StackPanel>

        <!-- ===== 3. Buttons ============================================================= -->
        <StackPanel Grid.Row="4"
                    Grid.Column="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">

            <Button x:Name="BtnHome"
                    Width="100"
                    Height="30"
                    Content="Home Position"
                    Margin="0,0,10,0"
                    Click="BtnHome_Click" />

            <Button x:Name="BtnStartSignal"
                    Width="160"
                    Height="30"
                    Content="Ready to Start"
                    Margin="0,0,10,0"
                    Click="BtnStartSignal_Click" />

            <Button x:Name="BtnEndSignal"
                    Width="80"
                    Height="30"
                    Content="Draw"
                    Margin="0,0,10,0"
                    Click="BtnEndSignal_Click" />

            <Button x:Name="BtnSimulate"
                    Width="100"
                    Height="30"
                    Content="Simulate"
                    Click="BtnSimulate_Click" />
        </StackPanel>

        <!-- ===== Preview ================================================================ -->
        <Border Grid.Row="0"
                Grid.RowSpan="5"
                Grid.Column="1"
                BorderBrush="Black"
                BorderThickness="2"
                Padding="5">

            <Grid>

                <TextBlock Text="Preview"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontWeight="Bold" />

                <Image x:Name="ImgPreview"
                       Margin="0,25,0,0"
                       Stretch="Uniform" />
            </Grid>
        </Border>
    </Grid>
</Window>
